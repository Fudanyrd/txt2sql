@article{choi26text,
  title={Text-to-SQL in the Era of Large Language Models: A Survey of Reasoning-Centric and Efficiency-Centric Approaches},
  author={Choi, Gunhee and Wee, Dayeon and Choi, Jongmoo},
  journal={Electronics},
